# Copy to .env and fill in. Both are optional — the site works fine with
# either (or both) unset; analytics just won't load.

# Google Analytics 4 — Admin > Data Streams > your web stream > Measurement ID
PUBLIC_GA4_ID=

# PostHog — Project Settings > Project API Key
PUBLIC_POSTHOG_KEY=
# "https://us.i.posthog.com" (default) or "https://eu.i.posthog.com"
PUBLIC_POSTHOG_HOST=
