---
import type { ProjectIcon } from "@/data/projects";

interface Props {
  icon: ProjectIcon;
}

const { icon } = Astro.props;
---

<div
  class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-accent-soft"
>
  {
    icon === "fpl" && (
      <svg viewBox="0 0 64 64" class="h-8 w-8" fill="none">
        <rect x="12" y="30" width="8" height="18" rx="1.5" stroke="#1C1B19" stroke-width="2" />
        <rect x="26" y="20" width="8" height="28" rx="1.5" stroke="#1C1B19" stroke-width="2" />
        <rect x="40" y="12" width="8" height="36" rx="1.5" stroke="#1C1B19" stroke-width="2" />
        <circle cx="16" cy="14" r="5" fill="#B5502D" />
      </svg>
    )
  }
  {
    icon === "football" && (
      <svg viewBox="0 0 64 64" class="h-8 w-8" fill="none">
        <rect x="10" y="12" width="44" height="40" rx="4" stroke="#1C1B19" stroke-width="2" />
        <line x1="32" y1="12" x2="32" y2="52" stroke="#1C1B19" stroke-width="2" />
        <circle cx="32" cy="32" r="7" stroke="#1C1B19" stroke-width="2" />
        <circle cx="32" cy="32" r="2" fill="#B5502D" />
      </svg>
    )
  }
  {
    icon === "fitness" && (
      <svg viewBox="0 0 64 64" class="h-8 w-8" fill="none">
        <path
          d="M9 36h11l5-14 7 26 5-12h17"
          stroke="#1C1B19"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M50 12a10 10 0 1 0 0 20 8 8 0 0 1 0-20Z"
          fill="#B5502D"
        />
      </svg>
    )
  }
  {
    icon === "chat" && (
      <svg viewBox="0 0 64 64" class="h-8 w-8" fill="none">
        <path
          d="M12 14h24a5 5 0 0 1 5 5v12a5 5 0 0 1-5 5H22l-7 7v-7h-3a5 5 0 0 1-5-5V19a5 5 0 0 1 5-5Z"
          stroke="#1C1B19"
          stroke-width="2"
          stroke-linejoin="round"
        />
        <path
          d="m16 25 4 4 8-8"
          stroke="#1C1B19"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M36 28h13a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-2v6l-6-6h-5a4 4 0 0 1-4-4v-2"
          stroke="#B5502D"
          stroke-width="2"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</div>
