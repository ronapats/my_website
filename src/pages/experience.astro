---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { experience } from "@/data/experience";
---

<BaseLayout
  title="Experience"
  description="Work history framed around impact — engineering delivery and product leadership across Agoda, Amazon, Carsome, Poly.AI, and Digital Boost."
>
  <section class="mx-auto max-w-page px-6 pb-8 pt-20 sm:px-8 sm:pt-28">
    <p class="text-sm uppercase tracking-[0.2em] text-ink-soft">Experience</p>
    <h1 class="mt-4 max-w-2xl font-serif text-4xl leading-tight text-ink sm:text-5xl">
      Eight years turning infrastructure and product problems into shipped
      outcomes.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-ink-soft">
      From mega-infrastructure delivery in Japan and Macau to consumer
      customer-experience platforms at Agoda — the throughline is
      cross-functional execution under real constraints.
    </p>
  </section>

  <section class="mx-auto max-w-page px-6 py-8 sm:px-8">
    <div class="divide-y divide-line border-t border-line">
      {
        experience.map((employer) => (
          <div class="grid gap-6 py-12 sm:grid-cols-[1fr_2fr] sm:gap-12">
            <div>
              <div class="flex items-center gap-3">
                <img
                  src={employer.logo}
                  alt={`${employer.company} logo`}
                  width="40"
                  height="40"
                  class="h-10 w-10 rounded-lg border border-line object-contain p-1.5"
                  loading="lazy"
                />
                <h2 class="font-serif text-2xl text-ink">{employer.company}</h2>
              </div>
              <p class="mt-3 text-sm text-ink-soft">{employer.context}</p>
              <p class="mt-1 text-sm text-ink-soft">{employer.location}</p>
            </div>
            <div class="space-y-8">
              {employer.roles.map((role) => (
                <div>
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h3 class="font-medium text-ink">{role.title}</h3>
                    <span class="whitespace-nowrap text-sm text-ink-soft">
                      {role.period}
                    </span>
                  </div>
                  <ul class="mt-3 space-y-2">
                    {role.bullets.map((bullet) => (
                      <li class="flex gap-3 text-ink-soft">
                        <span class="mt-[9px] h-1 w-1 shrink-0 rounded-full bg-accent" />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="border-t border-line bg-white/40">
    <div
      class="mx-auto flex max-w-page flex-col items-start gap-4 px-6 py-14 sm:flex-row sm:items-center sm:justify-between sm:px-8"
    >
      <p class="font-serif text-xl text-ink">See how this translates into things I've built.</p>
      <a
        href="/portfolio"
        class="link-quiet shrink-0 rounded-full bg-ink px-6 py-3 text-sm text-bg transition-colors hover:bg-accent"
      >
        View portfolio
      </a>
    </div>
  </section>
</BaseLayout>
