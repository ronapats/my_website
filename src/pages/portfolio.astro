---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectIcon from "@/components/ProjectIcon.astro";
import { projects } from "@/data/projects";
---

<BaseLayout
  title="Portfolio"
  description="Case studies — side projects, including LINE bots."
>
  <section class="mx-auto max-w-page px-6 pb-8 pt-20 sm:px-8 sm:pt-28">
    <p class="text-sm uppercase tracking-[0.2em] text-ink-soft">Portfolio</p>
    <h1 class="mt-4 max-w-2xl font-serif text-4xl leading-tight text-ink sm:text-5xl">
      Things I've built or led.
    </h1>
    <p class="mt-6 max-w-xl text-lg text-ink-soft">
      Side projects, from shipped to in progress — click a card to expand it.
      Work case studies are next to go up here.
    </p>
  </section>

  <section class="mx-auto max-w-page px-6 py-8 sm:px-8">
    <div class="space-y-4">
      {
        projects.map((project) => (
          <details class="group rounded-xl border border-line open:border-accent">
            <summary class="flex cursor-pointer list-none items-start gap-4 px-6 py-6 sm:items-center">
              <ProjectIcon icon={project.icon} />
              <div class="flex flex-1 items-start justify-between gap-4 sm:items-center">
                <div>
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="rounded-full bg-accent-soft px-3 py-1 text-xs uppercase tracking-wide text-accent">
                      {project.type}
                    </span>
                    <span class="text-sm text-ink-soft">{project.meta}</span>
                  </div>
                  <h2 class="mt-3 font-serif text-xl text-ink">
                    {project.title}
                  </h2>
                  <p class="mt-1 text-sm text-ink-soft">{project.summary}</p>
                </div>
                <span
                  aria-hidden="true"
                  class="mt-1 shrink-0 text-xl text-ink-soft transition-transform group-open:rotate-45"
                >
                  +
                </span>
              </div>
            </summary>
            <div class="grid gap-6 border-t border-line px-6 py-6 sm:grid-cols-2">
              {project.screenshots && project.screenshots.length > 0 && (
                <div class="flex gap-4 overflow-x-auto pb-2 sm:col-span-2">
                  {project.screenshots.map((shot) => (
                    <button
                      type="button"
                      data-lightbox-trigger
                      data-src={shot.src}
                      data-alt={shot.alt}
                      class="group/shot relative h-80 shrink-0 cursor-zoom-in rounded-xl border border-line bg-accent-soft/20 p-2 text-left"
                      aria-label={`View larger: ${shot.alt}`}
                    >
                      <img
                        src={shot.src}
                        alt={shot.alt}
                        class="h-full w-auto rounded-lg object-contain"
                        loading="lazy"
                      />
                      <span class="pointer-events-none absolute inset-2 flex items-center justify-center rounded-lg bg-ink/0 opacity-0 transition group-hover/shot:bg-ink/10 group-hover/shot:opacity-100">
                        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-bg/90 text-ink shadow-sm">
                          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="7" />
                            <path d="M21 21l-4.3-4.3" />
                            <path d="M11 8v6M8 11h6" />
                          </svg>
                        </span>
                      </span>
                    </button>
                  ))}
                </div>
              )}
              <div class="space-y-4">
                <div>
                  <p class="text-xs uppercase tracking-wide text-ink-soft">
                    Context
                  </p>
                  <p class="mt-2 text-ink-soft">{project.context}</p>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-wide text-ink-soft">
                    Role
                  </p>
                  <p class="mt-2 text-ink-soft">{project.role}</p>
                </div>
              </div>
              <div class="space-y-4">
                <div>
                  <p class="text-xs uppercase tracking-wide text-ink-soft">
                    What I did
                  </p>
                  <ul class="mt-2 space-y-2">
                    {project.actions.map((action) => (
                      <li class="flex gap-3 text-ink-soft">
                        <span class="mt-[9px] h-1 w-1 shrink-0 rounded-full bg-accent" />
                        <span>{action}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <p class="text-xs uppercase tracking-wide text-ink-soft">
                    Outcome
                  </p>
                  <p class="mt-2 text-ink-soft">{project.outcome}</p>
                </div>
              </div>
              <div class="flex flex-wrap gap-2 sm:col-span-2">
                {project.tags.map((tag) => (
                  <span class="rounded-full border border-line px-3 py-1 text-xs text-ink-soft">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <dialog
    id="lightbox"
    class="max-h-none max-w-none overflow-hidden bg-transparent p-0 backdrop:bg-ink/90"
  >
    <button
      type="button"
      id="lightbox-close"
      aria-label="Close"
      class="fixed right-4 top-4 z-10 flex h-10 w-10 items-center justify-center rounded-full bg-bg/90 text-ink shadow-sm sm:right-6 sm:top-6"
    >
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
    <div class="flex h-screen w-screen items-center justify-center p-6 sm:p-12">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-h-full max-w-full rounded-lg object-contain"
      />
    </div>
  </dialog>

  <script>
    const dialog = document.getElementById("lightbox") as HTMLDialogElement;
    const img = document.getElementById("lightbox-img") as HTMLImageElement;
    const closeBtn = document.getElementById("lightbox-close");

    document.querySelectorAll<HTMLButtonElement>("[data-lightbox-trigger]").forEach((btn) => {
      btn.addEventListener("click", () => {
        img.src = btn.dataset.src ?? "";
        img.alt = btn.dataset.alt ?? "";
        dialog.showModal();
      });
    });

    closeBtn?.addEventListener("click", () => dialog.close());

    dialog.addEventListener("click", (event) => {
      if (event.target !== img) dialog.close();
    });

    dialog.addEventListener("close", () => {
      img.src = "";
    });
  </script>
</BaseLayout>
