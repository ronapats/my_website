---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { timeline } from "@/data/timeline";
---

<BaseLayout title="Home">
  <section class="mx-auto max-w-page px-6 pb-16 pt-20 sm:px-8 sm:pt-28">
    <div class="grid gap-12 sm:grid-cols-[1.5fr_1fr] sm:items-start sm:gap-16">
      <div>
        <p class="text-sm uppercase tracking-[0.2em] text-ink-soft">
          Bangkok — Product &amp; Program Management
        </p>
        <h1
          class="mt-6 max-w-3xl font-serif text-4xl leading-[1.15] text-ink sm:text-5xl sm:leading-[1.15]"
        >
          {/* PLACEHOLDER — this is the single most important sentence on the
          site. Swap for a real positioning statement: what you do, at what
          scale, with what kind of outcome. Not a job title. */}
          I turn ambiguous, cross-functional problems into shipped product —
          at companies from early-stage to Amazon-scale.
        </h1>
        <p class="mt-6 max-w-xl text-lg text-ink-soft">
          {/* PLACEHOLDER — 2-3 sentences of supporting context: current role,
          the throughline across past roles, what you're looking for next. */}
          Currently a Project Manager at Agoda. Previously at Amazon, Carsome,
          Poly.AI, and Digital Boost — across travel, e-commerce, and
          conversational AI. This paragraph needs your real framing.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="/portfolio"
            class="link-quiet rounded-full bg-ink px-6 py-3 text-sm text-bg transition-colors hover:bg-accent"
          >
            See what I've built
          </a>
          <a
            href="/experience"
            class="link-quiet rounded-full border border-line px-6 py-3 text-sm text-ink transition-colors hover:border-accent hover:text-accent"
          >
            Read my experience
          </a>
        </div>
      </div>
      <div class="order-first sm:order-none">
        <div class="aspect-square max-w-[280px] overflow-hidden rounded-2xl border border-line sm:max-w-none">
          <img
            src="/headshot.jpg"
            alt="Portrait of Ronapat Srisupavanich"
            width="960"
            height="960"
            class="h-full w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-page px-6 py-16 sm:px-8">
      <h2 class="font-serif text-2xl text-ink">Timeline</h2>
      <div class="relative mt-10 space-y-10 border-l border-line pl-8">
        {
          timeline.map((item) => (
            <div class="relative">
              <span class="absolute -left-8 top-1.5 h-2.5 w-2.5 -translate-x-1/2 rounded-full bg-accent ring-4 ring-bg" />
              <p class="text-xs uppercase tracking-wide text-ink-soft">
                {item.year} · {item.category}
              </p>
              <h3 class="mt-1 font-serif text-lg text-ink">{item.title}</h3>
              {item.org && (
                <p class="text-sm text-ink-soft">{item.org}</p>
              )}
              <p class="mt-2 max-w-2xl text-ink-soft">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
