---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title="Writing" description="Notes on product, execution, and building things.">
  <section class="mx-auto max-w-page px-6 pb-8 pt-20 sm:px-8 sm:pt-28">
    <p class="text-sm uppercase tracking-[0.2em] text-ink-soft">Writing</p>
    <h1 class="mt-4 max-w-2xl font-serif text-4xl leading-tight text-ink sm:text-5xl">
      Notes on product, execution, and things I'm building.
    </h1>
  </section>

  <section class="mx-auto max-w-page px-6 py-8 sm:px-8">
    <div class="divide-y divide-line border-t border-line">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="link-quiet group block py-8">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 class="font-serif text-2xl text-ink group-hover:text-accent">
                {post.data.title}
              </h2>
              <time
                datetime={post.data.pubDate.toISOString()}
                class="whitespace-nowrap text-sm text-ink-soft"
              >
                {dateFormat.format(post.data.pubDate)}
              </time>
            </div>
            <p class="mt-2 max-w-2xl text-ink-soft">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <span class="rounded-full border border-line px-3 py-1 text-xs text-ink-soft">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </a>
        ))
      }
      {
        posts.length === 0 && (
          <p class="py-12 text-ink-soft">No posts yet.</p>
        )
      }
    </div>
  </section>
</BaseLayout>
